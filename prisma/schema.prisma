generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONSULTANT
  LIVREUR
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum DeliveryMode {
  RETRAIT_CONSULTANT
  LIVRAISON_JAMAAL
}

enum ReturnStatus {
  EN_ATTENTE
  APPROUVE
  REMBOURSE
  REJETE
}

enum PaymentMethod {
  A_LA_LIVRAISON
  WAVE
  ORANGE_MONEY
  STRIPE
}

enum PaymentStatus {
  EN_ATTENTE
  PAYE
  ECHOUE
}

enum CouponType {
  POURCENTAGE
  MONTANT_FIXE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CONSULTANT)
  createdAt    DateTime @default(now())

  consultantId String?     @unique
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  livreurId String?  @unique
  livreur   Livreur? @relation(fields: [livreurId], references: [id], onDelete: SetNull)

  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  stockMovements      StockMovement[]
}

model LoginAttempt {
  email       String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Compteurs de limitation de débit partagés entre instances (voir src/lib/rate-limit.ts).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                String           @id @default(cuid())
  /// Numéro de fiche Chogan (productDetail/…).
  number            Int?
  /// Code produit Chogan (« Cod. » : 001M, 060, BSF016…).
  choganCode        String?
  /// Parfum de grande marque dont s'inspire la fragrance (ex. « Sauvage ») et sa marque (« Dior »).
  inspiredBy        String?
  inspiredBrand     String?
  slug              String           @unique
  name              String
  category          String
  family            String?
  topNotes          String[]
  heartNotes        String[]
  baseNotes         String[]
  shortDescription  String
  longDescription   String[]
  testerPrice       Int?
  volumes           Json?
  regularPrice      Int?
  /// Prix public Chogan en FCFA : base du prix de vente (Admin > Modèle économique).
  publicPrice       Int?
  reviewCount       Int              @default(0)
  rating            Float            @default(4.5)
  badge             String?
  colorFrom         String           @default("#16233a")
  colorTo           String           @default("#c9997a")
  photo             String?
  isOfficial        Boolean          @default(true)
  stock             Int              @default(0)
  lowStockThreshold Int              @default(5)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  variants          ProductVariant[]
  stockMovements    StockMovement[]
  reviews           Review[]

  @@index([category])
  @@index([choganCode])
}

/// Suivi du stock par variante (volume) d'un produit, en complément du champ
/// `volumes` (JSON, label+prix) déjà utilisé pour l'affichage. Une ligne par
/// couple (produit, libellé de volume) — les produits à format unique n'en
/// ont pas besoin et continuent d'utiliser Product.stock.
model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  volumeLabel       String
  /// Code Chogan du format (ex. 301M pour le 30 ml, T001M pour la recharge 15 ml).
  code              String?
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  orderItems        OrderItem[]
  stockMovements    StockMovement[]

  @@unique([productId, volumeLabel])
}

model StockMovement {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  delta         Int
  previousStock Int
  nextStock     Int
  reason        String
  /// VENTE, ANNULATION, RECEPTION, INVENTAIRE, PERTE, RETOUR, AJUSTEMENT
  kind          String          @default("AJUSTEMENT")
  /// Commande à l'origine du mouvement (ventes et annulations)
  orderId       String?
  /// Référence libre : bon de livraison Chogan, numéro d'inventaire…
  reference     String?
  createdAt     DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([kind, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  authorName String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Int
  active     Boolean    @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int        @default(0)
  createdAt  DateTime   @default(now())

  orders Order[]
}

model Referral {
  id           String      @id @default(cuid())
  code         String      @unique
  referrerId   String?
  referrer     Consultant? @relation("ConsultantReferrals", fields: [referrerId], references: [id])
  createdAt    DateTime    @default(now())
  expiresAt    DateTime?
  usedAt       DateTime?
  usedById     String?
  usedBy       Customer?   @relation("CustomerReferrals", fields: [usedById], references: [id])
  rewardPoints Int         @default(2000)

  @@index([code])
}

model PromoCode {
  id           String     @id @default(cuid())
  code         String     @unique
  consultantId String
  consultant   Consultant @relation("ConsultantPromoCodes", fields: [consultantId], references: [id])
  discountPct  Int        @default(5)
  description  String?
  usageLimit   Int        @default(0)
  usedCount    Int        @default(0)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([consultantId])
}

model FastStartBonus {
  id          String     @id @default(cuid())
  sponsorId   String
  sponsor     Consultant @relation("FastStartSponsor", fields: [sponsorId], references: [id])
  sponsoreeId String
  sponsoree   Consultant @relation("FastStartSponsoree", fields: [sponsoreeId], references: [id])
  amount      Int        @default(15000)
  awardedAt   DateTime?
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())

  @@unique([sponsorId, sponsoreeId])
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerEmail String?
  customerPhone String?
  address       String?
  status        OrderStatus @default(EN_ATTENTE)
  total         Int
  /// Position déduite d'une adresse approximative : le livreur doit la confirmer par téléphone.
  deliveryApprox      Boolean  @default(false)
  /// Lieu reconnu pour une adresse approximative (ex. « Sacré-Cœur 3, Dakar »).
  deliveryPlace       String?
  /// Stock de la commande : RESERVE (retiré du stock) ou LIBERE (remis en stock après annulation)
  stockState    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  giftWrap      Boolean     @default(false)
  giftMessage   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  consultantId String?
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  deliveryMode DeliveryMode @default(RETRAIT_CONSULTANT)
  livreurId    String?
  livreur      Livreur?     @relation(fields: [livreurId], references: [id], onDelete: SetNull)
  deliveryLat  Float?
  deliveryLng  Float?

  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryFee    Int           @default(0)
  /// Module livraison : étape ("A_PREPARER", "ASSIGNEE", "RECUPEREE", "EN_ROUTE", "LIVREE", "ECHEC"),
  /// distance depuis le dépôt, code à 4 chiffres remis par le client au livreur, part du livreur.
  deliveryStatus     String?
  deliveryDistanceKm Float?
  deliveryCode       String?
  deliveredAt        DateTime?
  livreurShare       Int       @default(0)
  /// Où livrer : "CLIENT" (adresse du client) ou "VENDEUR" (le consultant achète pour son client),
  /// et la personne que le livreur doit joindre.
  deliveryTarget       String?
  deliveryContactName  String?
  deliveryContactPhone String?
  deliveryEvents     DeliveryEvent[]
  livreurEarning     LivreurEarning?

  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount Int     @default(0)

  paymentMethod PaymentMethod @default(A_LA_LIVRAISON)
  paymentStatus PaymentStatus @default(EN_ATTENTE)
  paidAt        DateTime?
  paymentRef    String?

  notifications Notification[]
  returns       Return[]
  statusHistory OrderStatusHistory[]

  @@index([consultantId])
  @@index([livreurId])
  @@index([customerId])
  @@index([deliveryZoneId])
  @@index([couponId])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  volumeLabel String
  price       Int
  quantity    Int
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model DeliveryZone {
  id     String  @id @default(cuid())
  name   String
  fee    Int
  active Boolean @default(true)

  orders Order[]
}

model Consultant {
  id        String   @id @default(cuid())
  name      String
  city      String
  whatsapp  String
  email     String?
  active    Boolean  @default(true)
  slug      String?  @unique
  createdAt DateTime @default(now())

  /// Wallet de versement des commissions : "WAVE" ou "ORANGE_MONEY", et numéro (+221…).
  walletProvider String?
  walletNumber   String?
  /// Adresse où le consultant se fait livrer quand il achète pour le compte d'un client.
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?

  sponsorId String?
  sponsor   Consultant?  @relation("ConsultantSponsor", fields: [sponsorId], references: [id], onDelete: SetNull)
  sponsored Consultant[] @relation("ConsultantSponsor")

  user   User?
  orders Order[]

  commissionPayments CommissionPayment[]
  commissionEntries  CommissionEntry[]
  payouts            Payout[]
  targets            MonthlyTarget[]

  // Parrainage & codes promo
  referrals         Referral[]       @relation("ConsultantReferrals")
  promoCodes        PromoCode[]      @relation("ConsultantPromoCodes")
  fastStartBonuses  FastStartBonus[] @relation("FastStartSponsor")
  fastStartReceived FastStartBonus[] @relation("FastStartSponsoree")

  @@index([sponsorId])
  @@index([slug])
}

model CommissionPayment {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  amount       Int
  periodLabel  String
  note         String?
  paidAt       DateTime   @default(now())

  @@index([consultantId])
}

/// Objectif de CA mensuel. consultantId nul = objectif global (comptabilité).
model MonthlyTarget {
  id            String      @id @default(cuid())
  consultantId  String?
  consultant    Consultant? @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  year          Int
  month         Int
  targetRevenue Int
  createdAt     DateTime    @default(now())

  @@unique([consultantId, year, month])
}

model Livreur {
  id         String    @id @default(cuid())
  name       String
  phone      String
  active     Boolean   @default(true)
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  /// Wallet de versement de la part livreur : "WAVE" ou "ORANGE_MONEY".
  walletProvider String?
  walletNumber   String?

  user     User?
  orders   Order[]
  earnings LivreurEarning[]
  events   DeliveryEvent[]
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  notes         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders    Order[]
  referrals Referral[] @relation("CustomerReferrals")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Expense {
  id        String   @id @default(cuid())
  label     String
  amount    Int
  category  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  navLabel    String
  description String
  accent      String   @default("navy")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
}

model Return {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  amount      Int
  status      ReturnStatus @default(EN_ATTENTE)
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}

/// Journal d'activité des actions admin sensibles (créer/modifier/supprimer).
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MarketingAsset {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  category  String   @default("Général")
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String[]
  published Boolean  @default(true)
  date      DateTime @default(now())
}

model LoyaltyAccount {
  id        String         @id @default(cuid())
  phone     String         @unique
  name      String?
  points    Int            @default(0)
  lifetime  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    LoyaltyEvent[]
}

model LoyaltyEvent {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String
  points    Int
  orderId   String?
  note      String?
  createdAt DateTime       @default(now())

  @@index([accountId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  phone     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([phone, productId])
  @@index([phone])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  productId String?
  orderId   String?
  meta      Json?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

enum ApplicationStatus {
  NOUVELLE
  ACCEPTEE
  REFUSEE
}

/// Candidature publique pour devenir revendeur / consultant JAMAAL.
model ConsultantApplication {
  id           String            @id @default(cuid())
  name         String
  email        String
  phone        String
  city         String
  country      String            @default("Sénégal")
  experience   String?
  motivation   String?
  sponsorCode  String?
  status       ApplicationStatus @default(NOUVELLE)
  adminNote    String?
  consultantId String?
  createdAt    DateTime          @default(now())
  processedAt  DateTime?

  @@index([status, createdAt])
  @@index([email])
}

/// Message envoyé depuis le formulaire de contact du site.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

/// Annonce de l'équipe JAMAAL visible par tous les revendeurs (espace « Ma communication »).
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([pinned, createdAt])
}

/// Journal des messages WhatsApp envoyés (OUT) et reçus (IN) via le prestataire WhatsApp Business.
model WhatsAppMessage {
  id         String   @id @default(cuid())
  direction  String // OUT | IN
  toNumber   String // numéro du destinataire (OUT) ou de l'expéditeur (IN)
  kind       String // team | reseller | test | inbound
  body       String
  status     String // SIMULE | ENVOYE | LIVRE | LU | ECHEC | RECU
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([providerId])
}

/// Commission due à un membre sur une commande (une ligne par bénéficiaire et par niveau).
model CommissionEntry {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  orderId      String
  /// "VENTE" (vendeur), "NIVEAU_1" (parrain direct), "NIVEAU_2" (grand-parrain)
  level        String
  rate         Float
  base         Int
  amount       Int
  /// "A_VERSER", "VERSE", "ANNULE"
  status       String     @default("A_VERSER")
  payoutId     String?
  payout       Payout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([orderId, consultantId, level])
  @@index([consultantId, status])
}

/// Versement de commissions sur le wallet Wave / Orange Money d'un membre.
model Payout {
  id           String            @id @default(cuid())
  consultantId String
  consultant   Consultant        @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  amount       Int
  /// "WAVE" ou "ORANGE_MONEY"
  provider     String
  walletNumber String
  /// "EN_COURS", "VERSE", "ECHEC"
  status       String            @default("EN_COURS")
  providerRef  String?
  error        String?
  entries      CommissionEntry[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([consultantId])
  @@index([status])
}

/// Étape d'une livraison, horodatée et géolocalisée (position du livreur au moment de l'action).
model DeliveryEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  livreurId String?
  livreur   Livreur? @relation(fields: [livreurId], references: [id], onDelete: SetNull)
  status    String
  lat       Float?
  lng       Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Part du livreur sur une livraison, versée sur son wallet.
model LivreurEarning {
  id          String   @id @default(cuid())
  livreurId   String
  livreur     Livreur  @relation(fields: [livreurId], references: [id], onDelete: Cascade)
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  /// "A_VERSER", "EN_COURS", "VERSE", "ANNULE"
  status      String   @default("A_VERSER")
  provider    String?
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([livreurId, status])
}

/// Adresses « floues » déjà localisées (évite de rappeler le service de géocodage).
model GeocodeCache {
  query     String   @id
  lat       Float?
  lng       Float?
  label     String?
  source    String?
  createdAt DateTime @default(now())
}
