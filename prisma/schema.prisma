generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONSULTANT
  LIVREUR
  CLIENT
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum DeliveryMode {
  RETRAIT_CONSULTANT
  LIVRAISON_JAMAAL
}

enum ReturnStatus {
  EN_ATTENTE
  APPROUVE
  REMBOURSE
  REJETE
}

enum PaymentMethod {
  A_LA_LIVRAISON
  WAVE
  ORANGE_MONEY
  STRIPE
  WALLET
}

enum PaymentStatus {
  EN_ATTENTE
  PAYE
  ECHOUE
}

enum CouponType {
  POURCENTAGE
  MONTANT_FIXE
}

/// Connexion par e-mail ou par numéro de téléphone : au moins l'un des deux est renseigné
/// (contrainte CHECK en base, voir db/sql/20261011-15-inscription-telephone.sql).
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  /// Normalisé (chiffres uniquement, voir normalizePhone) pour servir d'identifiant de connexion.
  phone        String?  @unique
  passwordHash String
  name         String
  role         Role     @default(CONSULTANT)
  createdAt    DateTime @default(now())

  consultantId String?     @unique
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  livreurId String?  @unique
  livreur   Livreur? @relation(fields: [livreurId], references: [id], onDelete: SetNull)

  /// Compte client (rôle CLIENT) rattaché à sa fiche client (historique de commandes).
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Compte actif ? Un compte suspendu ne peut plus se connecter (session coupée au plus tard sous 5 minutes).
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  /// Profil de privilèges (administrateur restreint). Sans profil, un administrateur a l'accès complet.
  profileId   String?
  profile     AccessProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  stockMovements      StockMovement[]
}

/// Profil de privilèges d'équipe : accès par module (lecture / écriture). Voir src/lib/permissions.ts.
model AccessProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

/// Verrouillage anti-force-brute par identifiant de connexion (e-mail ou téléphone normalisé,
/// tel que saisi). Colonne renommée depuis « email » (voir migration 20261011-15).
model LoginAttempt {
  identifiant String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Compteurs de limitation de débit partagés entre instances (voir src/lib/rate-limit.ts).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// Robot anti-aspiration : visiteur bloqué (clé = adresse IP + empreinte du navigateur).
model BotBan {
  key       String   @id
  ip        String
  userAgent String?
  reason    String
  path      String?
  hits      Int      @default(1)
  until     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([until])
}

/// Requêtes refusées par jour (AAAA-MM-JJ) et par motif.
model BotBlockStat {
  day    String
  reason String
  count  Int    @default(0)

  @@id([day, reason])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                String           @id @default(cuid())
  /// Numéro de fiche Chogan (productDetail/…).
  number            Int?
  /// Code produit Chogan (« Cod. » : 001M, 060, BSF016…).
  choganCode        String?
  /// Parfum de grande marque dont s'inspire la fragrance (ex. « Sauvage ») et sa marque (« Dior »).
  inspiredBy        String?
  inspiredBrand     String?
  slug              String           @unique
  name              String
  category          String
  family            String?
  topNotes          String[]
  heartNotes        String[]
  baseNotes         String[]
  shortDescription  String
  longDescription   String[]
  testerPrice       Int?
  volumes           Json?
  regularPrice      Int?
  /// Prix public Chogan en FCFA : base du prix de vente (Admin > Modèle économique).
  publicPrice       Int?
  reviewCount       Int              @default(0)
  rating            Float            @default(4.5)
  badge             String?
  colorFrom         String           @default("#16233a")
  colorTo           String           @default("#c9997a")
  photo             String?
  /// Photos supplémentaires (après la photo principale), ex. importées depuis la fiche Chogan.
  gallery           String[]         @default([])
  isOfficial        Boolean          @default(true)
  stock             Int              @default(0)
  lowStockThreshold Int              @default(5)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  variants          ProductVariant[]
  stockMovements    StockMovement[]
  reviews           Review[]

  @@index([category])
  @@index([choganCode])
  /// Dernière vérification du prix sur le site Chogan (veille automatique).
  choganCheckedAt DateTime?
}

/// Suivi du stock par variante (volume) d'un produit, en complément du champ
/// `volumes` (JSON, label+prix) déjà utilisé pour l'affichage. Une ligne par
/// couple (produit, libellé de volume) — les produits à format unique n'en
/// ont pas besoin et continuent d'utiliser Product.stock.
model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  volumeLabel       String
  /// Code Chogan du format (ex. 301M pour le 30 ml, T001M pour la recharge 15 ml).
  code              String?
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  orderItems        OrderItem[]
  stockMovements    StockMovement[]

  @@unique([productId, volumeLabel])
}

model StockMovement {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  delta         Int
  previousStock Int
  nextStock     Int
  reason        String
  /// VENTE, ANNULATION, RECEPTION, INVENTAIRE, PERTE, RETOUR, AJUSTEMENT
  kind          String          @default("AJUSTEMENT")
  /// Commande à l'origine du mouvement (ventes et annulations)
  orderId       String?
  /// Référence libre : bon de livraison Chogan, numéro d'inventaire…
  reference     String?
  createdAt     DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([kind, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  authorName String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  /// Photo envoyée par le client avec son avis (stockage Blob).
  photo String?
}

model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Int
  active     Boolean    @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int        @default(0)
  createdAt  DateTime   @default(now())

  orders Order[]
}

model Referral {
  id           String      @id @default(cuid())
  code         String      @unique
  referrerId   String?
  referrer     Consultant? @relation("ConsultantReferrals", fields: [referrerId], references: [id])
  createdAt    DateTime    @default(now())
  expiresAt    DateTime?
  usedAt       DateTime?
  usedById     String?
  usedBy       Customer?   @relation("CustomerReferrals", fields: [usedById], references: [id])
  rewardPoints Int         @default(2000)

  @@index([code])
}

model PromoCode {
  id           String     @id @default(cuid())
  code         String     @unique
  consultantId String
  consultant   Consultant @relation("ConsultantPromoCodes", fields: [consultantId], references: [id])
  discountPct  Int        @default(5)
  description  String?
  usageLimit   Int        @default(0)
  usedCount    Int        @default(0)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([consultantId])
}

model FastStartBonus {
  id          String     @id @default(cuid())
  sponsorId   String
  sponsor     Consultant @relation("FastStartSponsor", fields: [sponsorId], references: [id])
  sponsoreeId String
  sponsoree   Consultant @relation("FastStartSponsoree", fields: [sponsoreeId], references: [id])
  amount      Int        @default(15000)
  awardedAt   DateTime?
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())

  @@unique([sponsorId, sponsoreeId])
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerEmail String?
  customerPhone String?
  address       String?
  status        OrderStatus @default(EN_ATTENTE)
  total         Int
  /// Position déduite d'une adresse approximative : le livreur doit la confirmer par téléphone.
  deliveryApprox      Boolean  @default(false)
  /// Lieu reconnu pour une adresse approximative (ex. « Sacré-Cœur 3, Dakar »).
  deliveryPlace       String?
  /// Stock de la commande : RESERVE (retiré du stock) ou LIBERE (remis en stock après annulation)
  stockState    String?
  /// Réservation d'un produit en rupture : acompte payé d'avance, solde à l'arrivée du stock.
  isReservation      Boolean   @default(false)
  depositAmount      Int       @default(0)
  depositPaidAt      DateTime?
  /// ACOMPTE_ATTENDU → RESERVEE (acompte payé) → DISPONIBLE (stock arrivé, client prévenu) → SOLDEE, ou ANNULEE
  reservationStatus  String?
  /// Délai annoncé au client au moment de la réservation (ex. « 15 à 21 jours »).
  reservationDelay   String?
  reservationReadyAt DateTime?
  /// Paiement en 2 ou 3 fois (src/lib/installments.ts) : 0 = en une fois.
  installmentCount        Int       @default(0)
  installmentsPaid        Int       @default(0)
  installmentIntervalDays Int       @default(15)
  /// Références des paiements d'échéances déjà comptés (un même paiement n'est jamais compté deux fois).
  installmentRefs         String[]  @default([])
  installmentNextDue      DateTime?
  /// Date de paiement de chaque échéance réglée (dans l'ordre).
  installmentPaidDates    DateTime[] @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  giftWrap      Boolean     @default(false)
  giftMessage   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  consultantId String?
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  deliveryMode DeliveryMode @default(RETRAIT_CONSULTANT)
  livreurId    String?
  livreur      Livreur?     @relation(fields: [livreurId], references: [id], onDelete: SetNull)
  deliveryLat  Float?
  deliveryLng  Float?

  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryFee    Int           @default(0)
  /// Module livraison : étape ("A_PREPARER", "ASSIGNEE", "RECUPEREE", "EN_ROUTE", "LIVREE", "ECHEC"),
  /// distance depuis le dépôt, code à 4 chiffres remis par le client au livreur, part du livreur.
  deliveryStatus     String?
  deliveryDistanceKm Float?
  deliveryCode       String?
  deliveredAt        DateTime?
  livreurShare       Int       @default(0)
  /// Où livrer : "CLIENT" (adresse du client) ou "VENDEUR" (le consultant achète pour son client),
  /// et la personne que le livreur doit joindre.
  deliveryTarget       String?
  deliveryContactName  String?
  deliveryContactPhone String?
  deliveryEvents     DeliveryEvent[]
  livreurEarning     LivreurEarning?

  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount Int     @default(0)

  paymentMethod PaymentMethod @default(A_LA_LIVRAISON)
  paymentStatus PaymentStatus @default(EN_ATTENTE)
  paidAt        DateTime?
  paymentRef    String?
  /// Commande annulée après encaissement (ou acompte de réservation) : remboursement effectué au client.
  refundedAt    DateTime?
  refundNote    String?
  /// Canal du remboursement (CAISSE, WAVE, ORANGE_MONEY, BANQUE) ou CONSERVE (acompte gardé par JAMAAL).
  refundChannel String?

  notifications Notification[]
  returns       Return[]
  statusHistory OrderStatusHistory[]

  @@index([consultantId])
  @@index([livreurId])
  @@index([customerId])
  @@index([deliveryZoneId])
  @@index([couponId])
  @@index([isReservation, reservationStatus])
  /// Offre de fêtes appliquée (titre), la remise est dans discountAmount.
  offerTitle String?
  /// Origine de la commande : SITE, WHATSAPP (assistant ou panier WhatsApp), REVENDEUR (saisie ou message du revendeur).
  channel String @default("SITE")
  /// Cadeau à distance : occasion (Tabaski, mariage…), message vocal (adresse), nom de l'expéditeur.
  giftOccasion   String?
  giftVoiceUrl   String?
  giftFrom       String?
  /// Carte cadeau utilisée pour payer (tout ou partie) et abonnement de réassort à l'origine de la commande.
  giftCardId     String?
  subscriptionId String?
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  volumeLabel String
  price       Int
  quantity    Int
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model DeliveryZone {
  id     String  @id @default(cuid())
  name   String
  fee    Int
  active Boolean @default(true)

  orders Order[]
}

model Consultant {
  id        String   @id @default(cuid())
  name      String
  city      String
  whatsapp  String
  email     String?
  active    Boolean  @default(true)
  slug      String?  @unique
  createdAt DateTime @default(now())

  /// Wallet de versement des commissions : "WAVE" ou "ORANGE_MONEY", et numéro (+221…).
  walletProvider String?
  walletNumber   String?
  /// Nom du titulaire du compte Wave / Orange Money (vérifié avant le premier versement).
  walletHolderName String?
  /// Adresse et pièce d'identité reprises de la candidature acceptée.
  address        String?
  idType         String?
  idNumber       String?
  /// Adresse où le consultant se fait livrer quand il achète pour le compte d'un client.
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?

  /// Rang attribué par l'admin : "LEADER", "PARRAIN" ou "CONSULTANT". Vide : déduit de la place dans la chaîne.
  rank      String?
  sponsorId String?
  sponsor   Consultant?  @relation("ConsultantSponsor", fields: [sponsorId], references: [id], onDelete: SetNull)
  sponsored Consultant[] @relation("ConsultantSponsor")

  user   User?
  orders Order[]
  piece  ConsultantPiece?

  commissionPayments CommissionPayment[]
  commissionEntries  CommissionEntry[]
  payouts            Payout[]
  targets            MonthlyTarget[]

  // Parrainage & codes promo
  referrals         Referral[]       @relation("ConsultantReferrals")
  promoCodes        PromoCode[]      @relation("ConsultantPromoCodes")
  fastStartBonuses  FastStartBonus[] @relation("FastStartSponsor")
  fastStartReceived FastStartBonus[] @relation("FastStartSponsoree")

  @@index([sponsorId])
  @@index([slug])
  /// Relances automatiques de ses clients (rappel, anniversaire, panier) : le revendeur peut les couper.
  autoRelances Boolean @default(true)
  /// Kit du matin sur WhatsApp (visuel + texte + lien du jour).
  kitMatin Boolean @default(true)
  /// Boutique personnelle (/c/<slug>) : photo, présentation, coups de cœur (identifiants produits, dans l'ordre).
  shopPhoto String?
  shopBio   String?
  favorites String[] @default([])
  /// Thème visuel choisi pour la boutique (/c/<slug>) parmi la bibliothèque de thèmes JAMAAL.
  shopTheme String?   @default("maison")
  /// Phrase d'accroche ou slogan personnalisé de la boutique.
  shopTagline String?
  /// Personnalisation du thème : accent (0, 1 ou 2), mise en avant du haut de page, typographie, sections masquées.
  shopAccent Int @default(0)
  shopHero   String @default("portrait")
  shopTypo   String @default("theme")
  shopHidden String[] @default([])
  /// Libellés des badges de l'Académie : « f » (Experte parfums) ou « m » (Expert parfums).
  titleForm String?
  /// Conditions spéciales (encaissement direct, commission propre, zones de livraison propres), sinon le régime normal.
  specialTermsId String?
  specialTerms   SpecialTerms? @relation(fields: [specialTermsId], references: [id], onDelete: SetNull)
  shopEvents ShopEvent[]
}

model CommissionPayment {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  amount       Int
  periodLabel  String
  note         String?
  paidAt       DateTime   @default(now())

  @@index([consultantId])
}

/// Objectif de CA mensuel. consultantId nul = objectif global (comptabilité).
model MonthlyTarget {
  id            String      @id @default(cuid())
  consultantId  String?
  consultant    Consultant? @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  year          Int
  month         Int
  targetRevenue Int
  createdAt     DateTime    @default(now())

  @@unique([consultantId, year, month])
}

model Livreur {
  id         String    @id @default(cuid())
  name       String
  phone      String
  active     Boolean   @default(true)
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  /// Wallet de versement de la part livreur : "WAVE" ou "ORANGE_MONEY".
  walletProvider String?
  walletNumber   String?

  user     User?
  orders   Order[]
  earnings LivreurEarning[]
  events   DeliveryEvent[]
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  notes         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User?
  orders    Order[]
  referrals Referral[] @relation("CustomerReferrals")
  /// A répondu STOP sur WhatsApp : plus aucun message automatique.
  whatsappOptOut Boolean  @default(false)
  /// Anniversaire « MM-JJ » (message et code cadeau automatiques).
  birthday       String?
  /// Profil olfactif « Parfum ADN » : parfums portés, familles et notes préférées (relances et conseils).
  scentProfile   Json?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Expense {
  id          String    @id @default(cuid())
  label       String
  /// Montant TTC payé ou dû (FCFA)
  amount      Int
  category    String
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  /// Comptabilité : TVA récupérable incluse dans le montant, compte de charge (plan SYSCOHADA),
  /// moyen de paiement (compte de trésorerie), fournisseur, pièce justificative.
  vatAmount   Int       @default(0)
  account     String?
  channel     String    @default("CAISSE")
  supplier    String?
  reference   String?
  note        String?
  paid        Boolean   @default(true)
  paidAt      DateTime?
  dueDate     DateTime?
  receipt     Bytes?
  receiptMime String?
  receiptName String?
  createdBy   String?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([date])
}

/// Écriture saisie à la main (opérations diverses, à-nouveaux, virements internes…).
model JournalEntry {
  id         String   @id @default(cuid())
  date       DateTime
  /// Code journal : OD, AN, BQ, CA…
  journal    String   @default("OD")
  label      String
  reference  String?
  /// [{ account, label?, debit, credit, aux? }]
  lines      Json
  /// Modèle utilisé (APPORT, VIREMENT, TVA…) pour l'affichage.
  template   String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([date])
}

/// Budget mensuel d'un compte de charge ou de produit.
model Budget {
  id      String @id @default(cuid())
  /// AAAA-MM
  month   String
  account String
  amount  Int

  @@unique([month, account])
}

/// Mois clôturé : plus aucune saisie datée de ce mois ; photo des soldes au moment de la clôture.
model AccountingPeriod {
  month    String   @id
  closedAt DateTime @default(now())
  closedBy String?
  snapshot Json
  note     String?
}

/// Comptage de caisse ou rapprochement d'un compte de trésorerie (Wave, Orange Money, banque…).
model CashCount {
  id          String   @id @default(cuid())
  account     String
  date        DateTime
  counted     Int
  theoretical Int
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([account, date])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  navLabel    String
  description String
  accent      String   @default("navy")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
}

model Return {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  amount      Int
  status      ReturnStatus @default(EN_ATTENTE)
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}

/// Journal d'activité des actions admin sensibles (créer/modifier/supprimer).
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MarketingAsset {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  category  String   @default("Général")
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String[]
  published Boolean  @default(true)
  date      DateTime @default(now())
}

model LoyaltyAccount {
  id        String         @id @default(cuid())
  phone     String         @unique
  name      String?
  points    Int            @default(0)
  lifetime  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    LoyaltyEvent[]
}

model LoyaltyEvent {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String
  points    Int
  orderId   String?
  note      String?
  createdAt DateTime       @default(now())

  @@index([accountId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  phone     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([phone, productId])
  @@index([phone])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  productId String?
  orderId   String?
  meta      Json?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

enum ApplicationStatus {
  NOUVELLE
  ACCEPTEE
  REFUSEE
}

/// Candidature publique pour devenir revendeur / consultant JAMAAL.
model ConsultantApplication {
  id           String            @id @default(cuid())
  name         String
  email        String
  phone        String
  city         String
  country      String            @default("Sénégal")
  experience   String?
  motivation   String?
  sponsorCode  String?
  status       ApplicationStatus @default(NOUVELLE)
  adminNote    String?
  consultantId String?
  /// Adresse complète et pièce d'identité (photos privées, visibles des seuls admins).
  address      String?
  idType       String?
  idNumber     String?
  idFront      Bytes?
  idBack       Bytes?
  idMime       String?
  signature    ProtocolSignature?
  createdAt    DateTime          @default(now())
  processedAt  DateTime?

  @@index([status, createdAt])
  @@index([email])
}

/// Message envoyé depuis le formulaire de contact du site.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

/// Annonce de l'équipe JAMAAL visible par tous les revendeurs (espace « Ma communication »).
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([pinned, createdAt])
}

/// Journal des messages WhatsApp envoyés (OUT) et reçus (IN) via le prestataire WhatsApp Business.
model WhatsAppMessage {
  id         String   @id @default(cuid())
  direction  String // OUT | IN
  toNumber   String // numéro du destinataire (OUT) ou de l'expéditeur (IN)
  kind       String // team | reseller | test | inbound
  body       String
  status     String // SIMULE | ENVOYE | LIVRE | LU | ECHEC | RECU
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([providerId])
  @@index([toNumber, createdAt])
  /// Campagne d'origine (envois groupés).
  campaignId String?
}

/// Commission due à un membre sur une commande (une ligne par bénéficiaire et par niveau).
model CommissionEntry {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  orderId      String
  /// "VENTE" (vendeur), "NIVEAU_1" (parrain direct), "NIVEAU_2" (grand-parrain)
  level        String
  rate         Float
  base         Int
  amount       Int
  /// "A_VERSER", "VERSE", "ANNULE"
  status       String     @default("A_VERSER")
  payoutId     String?
  payout       Payout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([orderId, consultantId, level])
  @@index([consultantId, status])
}

/// Versement de commissions sur le wallet Wave / Orange Money d'un membre.
model Payout {
  id           String            @id @default(cuid())
  consultantId String
  consultant   Consultant        @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  amount       Int
  /// "WAVE" ou "ORANGE_MONEY"
  provider     String
  walletNumber String
  /// "EN_COURS", "VERSE", "ECHEC"
  status       String            @default("EN_COURS")
  providerRef  String?
  error        String?
  entries      CommissionEntry[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([consultantId])
  @@index([status])
}

/// Étape d'une livraison, horodatée et géolocalisée (position du livreur au moment de l'action).
model DeliveryEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  livreurId String?
  livreur   Livreur? @relation(fields: [livreurId], references: [id], onDelete: SetNull)
  status    String
  lat       Float?
  lng       Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Part du livreur sur une livraison, versée sur son wallet.
model LivreurEarning {
  id          String   @id @default(cuid())
  livreurId   String
  livreur     Livreur  @relation(fields: [livreurId], references: [id], onDelete: Cascade)
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  /// "A_VERSER", "EN_COURS", "VERSE", "ANNULE"
  status      String   @default("A_VERSER")
  provider    String?
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([livreurId, status])
}

/// Adresses « floues » déjà localisées (évite de rappeler le service de géocodage).
model GeocodeCache {
  query     String   @id
  lat       Float?
  lng       Float?
  label     String?
  source    String?
  createdAt DateTime @default(now())
}

/// Protocole de partenariat signé à l'écran (candidature ou membre déjà en place).
model ProtocolSignature {
  id            String                  @id @default(cuid())
  version       Int
  /// Texte exact signé (empreinte SHA-256 + copie, pour reproduire le PDF).
  textHash      String
  text          String
  signerName    String
  idType        String?
  idNumber      String?
  address       String?
  phone         String?
  /// Signature dessinée (PNG).
  image         Bytes
  ip            String?
  userAgent     String?
  signedAt      DateTime                @default(now())
  applicationId String?                 @unique
  application   ConsultantApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  consultantId  String?

  @@index([consultantId])
}

/// Wallet JAMAAL d'un revendeur (consultant) ou d'un livreur : registre de mouvements.
/// Solde = mouvements VALIDE + retraits EN_ATTENTE (bloqués jusqu'au versement).
model WalletTransaction {
  id          String   @id @default(cuid())
  /// "CONSULTANT" ou "LIVREUR"
  ownerType   String
  ownerId     String
  /// Montant signé (FCFA) : crédit > 0, débit < 0
  amount      Int
  /// COMMISSION, PRIME, LIVRAISON, DEPOT, RETRAIT, PAIEMENT, ANNULATION, AJUSTEMENT
  kind        String
  /// EN_ATTENTE, VALIDE, ECHEC, ANNULE
  status      String   @default("VALIDE")
  provider    String?
  phone       String?
  providerRef String?
  /// Origine unique (commission, gain de livraison…) : un même gain n'est crédité qu'une fois.
  sourceId    String?  @unique
  orderId     String?
  note        String?
  error       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerType, ownerId, status])
  @@index([status, kind])
}

/// Envois automatiques déjà faits (relances, demandes d'avis, résumés, primes de défi) : clé unique, jamais deux fois.
model AutomationSent {
  key       String   @id
  createdAt DateTime @default(now())
}

/// Panier commencé au paiement (téléphone saisi) mais pas commandé : relance WhatsApp.
model AbandonedCart {
  id           String    @id @default(cuid())
  phone        String
  name         String?
  items        Json
  total        Int
  consultantId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  remindedAt   DateTime?
  orderedAt    DateTime?

  @@index([phone])
  @@index([updatedAt])
}

/// Offre de fêtes : un coffret de produits à prix spécial, sur une période.
model Offer {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  occasion    String?
  description String   @default("")
  image       String?
  productIds  String[]
  packPrice   Int
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active, endsAt])
}

/// Défi du mois pour les revendeurs : objectif (nombre de ventes ou chiffre d'affaires) et bonus.
model Challenge {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  /// "VENTES" (nombre de commandes) ou "CA" (FCFA encaissés)
  metric      String
  target      Int
  bonus       Int
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean   @default(true)
  awardedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([active, endsAt])
}

/// Résultat d'un revendeur à un quiz de formation (le meilleur score est gardé).
model QuizResult {
  id           String   @id @default(cuid())
  consultantId String
  quizId       String
  score        Int
  total        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([consultantId, quizId])
}

/// Changement de prix détecté sur le site Chogan (veille automatique).
model ChoganPriceChange {
  id         String   @id @default(cuid())
  productId  String
  name       String
  oldPublic  Int?
  newPublic  Int
  detectedAt DateTime @default(now())
  seen       Boolean  @default(false)

  @@index([detectedAt])
}

/// Conversation WhatsApp avec un numéro (boîte de réception) : lecture, pause de l'assistant.
model WhatsAppThread {
  phone          String    @id
  name           String?
  lastMessageAt  DateTime  @default(now())
  lastReadAt     DateTime?
  botPausedUntil DateTime?
  createdAt      DateTime  @default(now())

  @@index([lastMessageAt])
}

/// Campagne WhatsApp (message groupé à une audience ciblée).
model WhatsAppCampaign {
  id        String    @id @default(cuid())
  title     String
  body      String
  audience  Json
  status    String    @default("BROUILLON")
  total     Int       @default(0)
  sent      Int       @default(0)
  failed    Int       @default(0)
  createdBy String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}

/// Code de parrainage créé par l'administrateur (ex. « JAMAAL », « SALON2026 ») : une candidature
/// qui l'utilise est rattachée au parrain choisi. S'ajoute au code personnel de chaque revendeur
/// (son identifiant /c/<slug>).
model SponsorCode {
  id           String   @id @default(cuid())
  code         String   @unique
  consultantId String
  label        String?
  active       Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([consultantId])
}

/// Photos de la pièce d'identité d'un consultant (privées, visibles des seuls admins).
model ConsultantPiece {
  consultantId String     @id
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  front        Bytes?
  back         Bytes?
  mime         String?
  updatedAt    DateTime   @default(now()) @updatedAt
}

/// Abonnement de réassort : la même commande recréée automatiquement tous les N jours, avec une remise.
model Subscription {
  id            String    @id @default(cuid())
  token         String    @unique
  customerName  String
  customerPhone String
  customerEmail String?
  consultantId  String?
  /// [{ productId, productName, volumeLabel, quantity }]
  items         Json
  intervalDays  Int       @default(45)
  discountPct   Int       @default(5)
  /// { mode: "LIVRAISON" | "RETRAIT", lat, lng, address, place }
  delivery      Json?
  /// ACTIVE, PAUSE, ANNULE
  status        String    @default("ACTIVE")
  nextRunAt     DateTime
  remindedAt    DateTime?
  lastOrderId   String?
  sourceOrderId String?
  ordersCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextRunAt], map: "Subscription_status_next_idx")
  @@index([customerPhone], map: "Subscription_phone_idx")
}

/// Carte cadeau : achetée (souvent depuis l'étranger), envoyée par WhatsApp, utilisable en un ou plusieurs achats.
model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  amount         Int
  balance        Int       @default(0)
  /// EN_ATTENTE (non payée), ACTIVE, EPUISEE, ANNULEE
  status         String    @default("EN_ATTENTE")
  buyerName      String
  buyerPhone     String?
  buyerEmail     String?
  recipientName  String
  recipientPhone String
  occasion       String?
  message        String?
  voiceUrl       String?
  consultantId   String?
  paymentMethod  String?
  paymentRef     String?
  paidAt         DateTime?
  sentAt         DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status], map: "GiftCard_status_idx")
}

/// Signalement de fraude possible sur les commissions (auto-achat, faux filleul, retours abusifs). Tant qu'il est
/// OUVERT, les commissions concernées restent « EN_REVUE » : rien n'est versé avant la décision de l'admin.
model FraudFlag {
  id           String    @id @default(cuid())
  /// Clé unique (évite les doublons) : « order:<id> » ou « member:<type>:<consultant> »
  key          String    @unique
  /// AUTO_ACHAT, ACHAT_PARRAIN, FAUX_FILLEUL, CLIENT_UNIQUE, RETOURS
  kind         String
  consultantId String
  orderId      String?
  details      String
  score        Int       @default(1)
  /// OUVERT, VALIDE (pas de fraude : commissions libérées), FRAUDE (commissions annulées)
  status       String    @default("OUVERT")
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())

  @@index([status], map: "FraudFlag_status_idx")
  @@index([consultantId], map: "FraudFlag_consultant_idx")
}

/// Conditions spéciales accordées à un ou plusieurs revendeurs (Admin › Conditions spéciales).
model SpecialTerms {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  note      String?
  /// Le revendeur encaisse lui-même son client : ESPECES, WAVE, ORANGE_MONEY. La vente est payée aussitôt et
  /// le montant est porté au débit de son wallet (argent à reverser à JAMAAL).
  collectMethods String[] @default([])
  /// Argent encaissé et pas encore reversé que le revendeur peut garder au maximum (F) : solde wallet jusqu'à -plafond.
  creditLimit    Int      @default(0)
  /// Taux propres (%) sur les ventes de ces revendeurs ; vide = taux du modèle économique.
  sellerPct  Float?
  level1Pct  Float?
  level2Pct  Float?
  /// Zones de livraison propres : [{ "name": "Thiès centre", "fee": 1500 }] — tarif fixe au lieu du tarif au km.
  zones     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consultants Consultant[]
}

/// Statistiques de la boutique personnelle (/c/<slug>) : « visite », « whatsapp » ou « produit ».
/// « sid » : identifiant de visite anonyme tiré au hasard dans le navigateur (aucune donnée personnelle).
model ShopEvent {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  kind         String
  productId    String?
  sid          String?
  createdAt    DateTime   @default(now())

  @@index([consultantId, createdAt])
  @@index([sid])
}
