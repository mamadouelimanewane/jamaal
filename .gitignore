# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# import source : données personnelles/officielles du revendeur, à ne pas
# committer telles quelles (voir import/README.md) — seul le résultat traité
# (src/data/official-catalog.json + public/produits/) est versionné.
/import/products.csv
/import/photos/*
!/import/photos/.gitkeep
